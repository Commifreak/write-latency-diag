#!/bin/bash
#
# CheckMK local check (fast part, runs on every agent call):
# latency and flush times per SSD, IO and CPU pressure (PSI) and the biggest writers.
#
# Installation: copy to /usr/lib/check_mk_agent/local/write_latency and make it executable.
# Each run measures since the previous call (state file); the first call only records starting values.
#

# If the write-latency-diag service is running (--install-service), it supplies the values: the web UI and CheckMK
# then rely on the same measurement, and SMART is queried only once. Otherwise (or without data) the check measures itself.
# Always process numbers with a dot: with a German or other locale awk would print "3,000", bash printf would reject
# "3.5" and comparisons would turn into string comparisons.
if [ -n "${LC_ALL:-}" ]; then export LANG="$LC_ALL"; unset LC_ALL; fi
export LC_NUMERIC=C

from_service() {
  local conf=/etc/write-latency-diag.conf port bind url out
  [ -f "$conf" ] || return 1
  port=$(sed -n 's/^ *port *= *\([0-9]*\).*/\1/p' "$conf" | tail -1)
  bind=$(sed -n 's/^ *bind *= *\([^ #]*\).*/\1/p' "$conf" | tail -1)
  case "$bind" in ""|0.0.0.0|::) bind=127.0.0.1 ;; esac
  url="http://$bind:${port:-81}/api/checkmk?part=$1"
  if command -v curl >/dev/null 2>&1; then out=$(curl -fsS --max-time 5 "$url" 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then out=$(wget -qO- -T 5 "$url" 2>/dev/null)
  else return 1; fi
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}
from_service fast && exit 0

STATE_DIR="/var/lib/write-latency-diag"
STATE="$STATE_DIR/checkmk-fast.state"
DEVRE='^(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|xvd[a-z]+)$'

# Thresholds (ms or %)
FLUSH_WARN=10;  FLUSH_CRIT=50
WAWAIT_WARN=20; WAWAIT_CRIT=100
PSI_IO_WARN=10; PSI_IO_CRIT=25
PSI_CPU_WARN=20; PSI_CPU_CRIT=40

mkdir -p "$STATE_DIR" 2>/dev/null
now=$(awk '{print $1}' /proc/uptime)

# Only non-rotational drives that are not attached via USB
ssds=""
for p in /sys/block/*; do
  d=${p##*/}
  [[ $d =~ $DEVRE ]] || continue
  [ "$(cat "$p/queue/rotational" 2>/dev/null)" = 0 ] || continue
  [[ $(readlink -f "$p/device" 2>/dev/null) == */usb* ]] && continue
  ssds="$ssds $d"
done

# Current values: drives (diskstats), bytes written per process (net, without data deleted before writeback)
cur=$(
  echo "T $now"
  awk -v list=" $ssds " 'index(list, " " $3 " ") { print "D", $3, $8, $10, $11, $13, ($19 == "" ? 0 : $19), ($20 == "" ? 0 : $20) }' /proc/diskstats
  grep -s -H -E '^(cancelled_)?write_bytes' /proc/[0-9]*/io | awk -F'[/: ]+' '
    { v = $NF; if ($5 ~ /^cancelled/) w[$3] -= v; else w[$3] += v }
    END { for (p in w) print "P", p, w[p] }'
  grep -s -H . /proc/[0-9]*/comm | awk '{ pid = $0; sub(/^\/proc\//, "", pid); sub(/\/.*/, "", pid); c = $0; sub(/^[^:]*:/, "", c); gsub(/ /, "_", c); print "C", pid, c }'
)

prev=""
[ -r "$STATE" ] && prev=$(cat "$STATE")
printf '%s\n' "$cur" | grep -v '^C ' > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"

if [ -z "$prev" ]; then
  for d in $ssds; do echo "0 \"SSD $d Latency\" - First measurement, values from the next agent call"; done
  echo "0 \"Top writers\" - First measurement, values from the next agent call"
else
  { printf '%s\n' "$prev" | sed 's/^/O /'; printf '%s\n' "$cur"; } | awk \
    -v fw=$FLUSH_WARN -v fc=$FLUSH_CRIT -v ww=$WAWAIT_WARN -v wc=$WAWAIT_CRIT '
    $1 == "O" && $2 == "T" { t0 = $3; next }
    $1 == "O" && $2 == "D" { for (i = 4; i <= 9; i++) od[$3, i] = $i; seen[$3] = 1; next }
    $1 == "O" && $2 == "P" { ow[$3] = $4; next }
    $1 == "T" { t1 = $2; next }
    $1 == "D" { for (i = 3; i <= 8; i++) nd[$2, i + 1] = $i; dev[$2] = 1; next }
    $1 == "P" { nw[$2] = $3; next }
    $1 == "C" { comm[$2] = $3; next }
    END {
      dt = t1 - t0; if (dt <= 0) dt = 1
      for (d in dev) {
        if (!(d in seen)) continue
        dw = nd[d, 4] - od[d, 4]; ds = nd[d, 5] - od[d, 5]; dwt = nd[d, 6] - od[d, 6]
        dio = nd[d, 7] - od[d, 7]; df = nd[d, 8] - od[d, 8]; dft = nd[d, 9] - od[d, 9]
        wa = dw > 0 ? dwt / dw : 0; fa = df > 0 ? dft / df : 0
        util = 100 * dio / (dt * 1000); if (util > 100) util = 100
        st = 0
        # Only rate after a few requests, single outliers while idle are not a finding
        if (df >= 10) { if (fa >= fc) st = 2; else if (fa >= fw && st < 1) st = 1 }
        if (dw >= 10) { if (wa >= wc) st = 2; else if (wa >= ww && st < 1) st = 1 }
        printf "%d \"SSD %s Latency\" flush_ms=%.2f;%d;%d|write_await_ms=%.2f;%d;%d|flush_per_s=%.1f|write_mbs=%.2f|util=%.1f;;;0;100 Flush %.2f ms (%.1f/s), write await %.2f ms, %.2f MB/s, utilization %.0f %% (average over %.0f s)\n",
          st, d, fa, fw, fc, wa, ww, wc, df / dt, ds * 512 / 1048576 / dt, util, fa, df / dt, wa, ds * 512 / 1048576 / dt, util, dt
      }
      # Top writers: increase per process, grouped by name. Child processes that have exited show up
      # under the parent that reaps them (e.g. systemd).
      for (p in nw) if (p in ow) { x = nw[p] - ow[p]; if (x > 0) { c = (p in comm) ? comm[p] : "pid" p; W[c] += x; tot += x } }
      s = ""
      for (i = 1; i <= 3; i++) {
        b = ""; bv = 0
        for (c in W) if (!(c in used) && W[c] > bv) { bv = W[c]; b = c }
        if (b == "" || bv / 1048576 / dt < 0.01) break
        used[b] = 1
        s = s (s == "" ? "" : ", ") b " " sprintf("%.2f MB/s", bv / 1048576 / dt)
      }
      printf "0 \"Top writers\" write_total_mbs=%.2f %s\n", tot / 1048576 / dt, (s == "" ? "hardly any writes" : s)
    }'
fi

# PSI: share of time in which processes wait for IO or CPU (average of the last 60 s)
psi() { awk -v k="$2" '$1 == k { for (i = 2; i <= NF; i++) if ($i ~ /^avg60=/) { sub("avg60=", "", $i); print $i } }' "/proc/pressure/$1" 2>/dev/null; }
io_some=$(psi io some); io_full=$(psi io full); cpu_some=$(psi cpu some)
if [ -n "$io_full" ]; then
  awk -v s="$io_some" -v f="$io_full" -v w=$PSI_IO_WARN -v c=$PSI_IO_CRIT 'BEGIN {
    st = f >= c ? 2 : f >= w ? 1 : 0
    printf "%d \"IO pressure\" psi_io_full=%.2f;%d;%d|psi_io_some=%.2f Processes fully blocked by IO: %.1f %%, partially: %.1f %% (avg60)\n", st, f, w, c, s, f, s }'
fi
if [ -n "$cpu_some" ]; then
  awk -v s="$cpu_some" -v w=$PSI_CPU_WARN -v c=$PSI_CPU_CRIT 'BEGIN {
    st = s >= c ? 2 : s >= w ? 1 : 0
    printf "%d \"CPU pressure\" psi_cpu_some=%.2f;%d;%d Processes waiting for CPU time: %.1f %% (avg60)\n", st, s, w, c, s }'
fi
